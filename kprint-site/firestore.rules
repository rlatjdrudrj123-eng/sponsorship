rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  권한 모델 (2026-10) — 전시회별 담당자
    //   - 관리자: 최초 관리자 계정 또는 members/{uid}.role == 'admin' (status 'active')
    //   - 담당자: members/{uid}.role == 'manager' (status 'active') — events 배열의 행사만 쓰기
    //   - 가입: 회사 메일 인증 → members/{uid} 를 'pending' 으로 생성 → 관리자 승인·행사 배정
    //  앱 화면 판정(lib/admin/access.ts, app/(admin)/admin/layout.tsx)과 같은 기준.
    //  NOTE: 주차관리 시스템은 별도 Firebase 프로젝트로 이전됨 → 관련 규칙 없음(2026-07).
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    // 최초 관리자 — ⚠️ lib/firebase/config.ts 의 BOOTSTRAP_ADMIN_UIDS / _EMAILS 와 같은 값.
    //   UID 고정(tom@eandex.co.kr)은 메일 인증 여부와 관계없이, 이메일은 인증된 경우에만.
    function isBootstrapAdmin() {
      return signedIn()
        && (request.auth.uid in ['EwckwTGAmBh9kLnBRQd2qCvVQ1e2']
            || (emailVerified()
                && request.auth.token.get('email', '') in ['tom@eandex.co.kr']));
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    // 승인된 멤버 (메일 인증 필수)
    function isActiveMember() {
      return signedIn()
        && emailVerified()
        && exists(memberPath())
        && get(memberPath()).data.status == 'active';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isActiveMember() && get(memberPath()).data.role == 'admin');
    }

    // 담당자에게 배정된 행사인지 — 관리자 판정은 호출부에서 먼저(단락 평가)
    function isAssigned(eventId) {
      return isActiveMember() && eventId in get(memberPath()).data.events;
    }

    // eventId 필드가 있는 컬렉션 공통 — 생성은 새 행사, 수정은 기존·변경 후 행사 모두,
    // 삭제는 기존 행사 권한. (eventId 없는 예전 문서는 관리자만)
    function canCreateScoped() {
      return isAdmin() || isAssigned(request.resource.data.eventId);
    }
    function canUpdateScoped() {
      return isAdmin()
        || (isAssigned(resource.data.eventId) && isAssigned(request.resource.data.eventId));
    }
    function canDeleteScoped() {
      return isAdmin() || isAssigned(resource.data.eventId);
    }

    // 행사를 만든 사람(소유자) — 그 행사에 담당자를 지정할 수 있다 (사용자 승인 2026-10-07).
    // getAfter: 행사 생성과 본인 배정을 한 번에(batch) 쓸 때도 새 행사 문서를 본다.
    function isEventOwner(eventId) {
      return isActiveMember()
        && request.auth.uid in getAfter(/databases/$(database)/documents/events/$(eventId)).data.get('ownerUids', []);
    }

    // 소유자의 담당자 지정 — 대상의 events 에 그 행사 하나만 넣거나 빼고, lastAssign 에 기록
    function isOwnerAssignment() {
      let after = request.resource.data;
      let before = resource.data;
      let ev = after.lastAssign.eventId;
      return isEventOwner(ev)
        && after.diff(before).affectedKeys().hasOnly(['events', 'lastAssign', 'updatedAt'])
        && before.status == 'active'
        && after.lastAssign.by == request.auth.uid
        && ((after.lastAssign.op == 'add'
              && !(ev in before.events)
              && after.events.size() == before.events.size() + 1
              && after.events.toSet() == before.events.toSet().union([ev].toSet()))
            || (after.lastAssign.op == 'remove'
              && ev in before.events
              && after.events.size() == before.events.size() - 1
              && after.events.toSet() == before.events.toSet().difference([ev].toSet())));
    }

    // ============================================================
    //  멤버 (어드민 사용자·권한)
    // ============================================================
    match /members/{uid} {
      // 승인된 멤버는 다른 '사용 중' 멤버를 볼 수 있다 (담당자 지정용). 신청·중지 계정은 관리자만.
      allow get: if signedIn()
                 && (request.auth.uid == uid
                     || isAdmin()
                     || (isActiveMember() && resource.data.status == 'active'));
      allow list: if isAdmin() || (isActiveMember() && resource.data.status == 'active');
      // 사용 신청 — 메일 인증을 마친 본인만, 담당자·대기·배정 없음으로만
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && emailVerified()
                    && request.resource.data.keys().hasOnly([
                         'uid','email','name','role','events','status','createdAt','updatedAt'
                       ])
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.role == 'manager'
                    && request.resource.data.status == 'pending'
                    && request.resource.data.events is list
                    && request.resource.data.events.size() == 0;
      // 승인·역할·행사 배정 — 관리자. 본인 역할·상태는 못 바꿈(실수로 자기 권한 잠금 방지)
      // 행사 소유자는 자기 행사 배정만 (isOwnerAssignment)
      allow update: if (isAdmin()
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.role in ['admin', 'manager']
                        && request.resource.data.status in ['pending', 'active', 'disabled']
                        && request.resource.data.events is list
                        && (request.auth.uid != uid
                            || (request.resource.data.role == resource.data.role
                                && request.resource.data.status == resource.data.status)))
                    || isOwnerAssignment();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ============================================================
    //  행사 — 공개 읽기.
    //  만들기: 관리자 또는 승인된 멤버(만든 사람이 소유자). 삭제·순서·공개 여부: 관리자.
    //  담당자: 이름·연도 등 기본 정보만.
    // ============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin()
                    || (isActiveMember()
                        && request.resource.data.keys().hasOnly([
                             'id','name','shortName','year','isActive','order','note',
                             'ownerUids','createdBy','createdAt','updatedAt'
                           ])
                        && request.resource.data.id == eventId
                        && request.resource.data.ownerUids == [request.auth.uid]
                        && request.resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin()
                    || (isAssigned(eventId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','shortName','year','lastYearTotal','updatedAt']));
    }

    // ============================================================
    //  스폰서십 상품 (행사별)
    // ============================================================
    match /categories/{id} {
      allow read: if resource.data.isPublished == true
                  || isAdmin()
                  || isAssigned(resource.data.eventId);
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }
    match /subcategories/{id} {
      allow read: if true;
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }
    match /slots/{id} {
      allow read: if true;
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }
    match /packages/{id} {
      allow read: if resource.data.isPublished == true
                  || isAdmin()
                  || isAssigned(resource.data.eventId);
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }
    // 페르소나 (참가업체 분류) — 공개 읽기
    match /personas/{id} {
      allow read: if true;
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }

    // ============================================================
    //  행사별 설정 — 문서 ID 가 행사 ID ('main' 은 예전 공용 문서 → 관리자만 쓰기)
    // ============================================================
    match /siteSettings/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || isAssigned(eventId);
    }
    match /taxonomy/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || isAssigned(eventId);
    }
    // 견적서 설정 (사무국 정보, 계좌번호, 사업자번호 등) — 공개 페이지 미사용, 내부 전용.
    // 'main' 은 예전 공용 문서(견적서 출력의 기본값)라 승인된 멤버 누구나 읽기.
    match /quoteSettings/{eventId} {
      allow read: if isAdmin()
                  || isAssigned(eventId)
                  || (eventId == 'main' && isActiveMember());
      allow write: if isAdmin() || isAssigned(eventId);
    }

    // ============================================================
    //  영업 데이터 (내부 전용, 행사별)
    // ============================================================
    match /sponsors/{id} {
      allow read: if isAdmin() || isAssigned(resource.data.eventId);
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }

    // 문의(견적 요청) — 익명 공개 생성. 스팸/위조 방지를 위해 화이트리스트 + 타입/길이 검증.
    // 실제 클라이언트 payload: app/(public)/[eventSlug]/contact/page.tsx (addDoc)
    //   eventId, companyName, contactName, email, phone, message,
    //   cartItems, cartSubtotal, cartVat, cartTotal,
    //   diagnosisContext(선택), privacyConsent, status, createdAt, updatedAt
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                         'eventId','companyName','contactName','email','phone','message',
                         'cartItems','cartSubtotal','cartVat','cartTotal',
                         'diagnosisContext','privacyConsent','status','createdAt','updatedAt'
                       ])
                    && request.resource.data.keys().hasAll([
                         'eventId','companyName','contactName','email','phone','message','status'
                       ])
                    && request.resource.data.status == 'new'
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() <= 200
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() <= 200
                    && request.resource.data.contactName is string
                    && request.resource.data.contactName.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 50
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.cartItems is list
                    && request.resource.data.cartSubtotal is number
                    && request.resource.data.cartVat is number
                    && request.resource.data.cartTotal is number
                    && (!('privacyConsent' in request.resource.data)
                        || request.resource.data.privacyConsent is bool);
      allow read: if isAdmin() || isAssigned(resource.data.eventId);
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }

    // 엑셀 업로드 이력 — 행사별 (eventId 없는 예전 이력은 관리자만)
    match /importHistory/{id} {
      allow read: if isAdmin() || isAssigned(resource.data.eventId);
      allow create: if canCreateScoped();
      allow update: if canUpdateScoped();
      allow delete: if canDeleteScoped();
    }

    // 진단 챗봇 로그 — 공개 생성 (익명 세션), 읽기는 행사 권한자
    // 실제 클라이언트 payload: components/public/SponsorshipDiagnosisChat.tsx (writeLog)
    //   eventId, sessionId, completed, exitedAt(선택), primaryGoal/secondaryGoal(선택·null 가능),
    //   budgetKRW(선택), mustHave(선택), recommendedCategoryIds(list), createdAt
    match /diagnostic_logs/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                         'eventId','sessionId','completed','exitedAt',
                         'primaryGoal','secondaryGoal','budgetKRW','mustHave',
                         'recommendedCategoryIds','createdAt'
                       ])
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() <= 200
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() <= 200
                    && request.resource.data.completed is bool
                    && request.resource.data.recommendedCategoryIds is list
                    && request.resource.data.recommendedCategoryIds.size() <= 50;
      allow read: if isAdmin() || isAssigned(resource.data.eventId);
      allow update, delete: if false;
    }

    // 변경 이력 — Cloud Functions(functions/src/index.ts)만 기록, 화면은 읽기만.
    // 담당자는 배정 행사 이력만 (쿼리에 eventId 등식 필터 필수). 멤버·권한 이력(eventId 없음)은 관리자.
    match /auditLogs/{id} {
      allow read: if isAdmin() || isAssigned(resource.data.eventId);
      allow write: if false;
    }

    // ============================================================
    //  그 외 모든 경로 차단
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
